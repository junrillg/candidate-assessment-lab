  "narrative": {
    "northStar": "The Laboratory Notebook",
    "overview": "The Laboratory Notebook makes work legible through cool paper, ink-blue controls and ruled regions. White working sheets sit on a cool gray field; visible acceptance, question state and human scoring carry the visual emphasis.\n\nThe system is calm, direct and deliberately flat. Compact navigation supports spacious answer and evidence regions. The learning walkthrough uses the same paper, ink, blue focus and ruled divisions, with its own reading proportions. Source evidence is the shipped frontend stylesheet and components, plus the walkthrough’s inline styles; the recorded system follows those implementations rather than the preliminary direction.",
    "keyCharacteristics": [
      "Cool field and white working sheets.",
      "Ink-blue actions, explicit textual states and tabular quantities.",
      "Ruled separation without shadows or ornamental imagery.",
      "Persistent work context; responsive navigation preserves state."
    ],
    "rules": [
      {
        "name": "The State Has Words Rule",
        "body": "Pair state color with readable status text; selection, completion and acceptance remain distinct.",
        "section": "colors"
      },
      {
        "name": "The Title First Rule",
        "body": "Question and checkpoint titles precede their metadata. Keep labels in sentence case and quantities tabular.",
        "section": "typography"
      },
      {
        "name": "The Ruled Sheet Rule",
        "body": "Use paper, tonal grounds and thin rules to separate work regions; the shipped system has no box shadows.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do preserve the distinction between local work, pending acceptance and server-saved work in persistent status text.",
      "Do keep question titles above metadata and reveal rubric detail through native disclosure.",
      "Do retain visible keyboard focus, textual mobile state, wrapping evidence and reduced-motion behavior.",
      "Do use the existing paper sheets and ruled sections for both candidate work and human review."
    ],
    "donts": [
      "Don't use success color alone as proof that work was accepted.",
      "Don't add ornamental notebook grids behind reading or response text.",
      "Don't merge AI suggestions into the visual or verbal identity of a final human score.",
      "Don't inherit the build’s 10–11px mobile navigation and audit metadata as a recommended type scale; these are carried density defects."
    ]
  }
}
